# ── Lumio / 灵智 环境变量配置 ──
# 复制此文件为 .env 并根据环境修改
# cp .env.example .env

# ── 全局 ──
LUMIO_ENVIRONMENT=development
LUMIO_DEBUG=true
LUMIO_LOG_LEVEL=INFO
LUMIO_SERVICE_HOST=127.0.0.1
LUMIO_STAR_CONNECTION_URL=http://localhost:8080
LUMIO_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# ── Bot 服务 ──
BOT_MAX_CONCURRENT_AGENTS=10
BOT_MESSAGE_TTL_SECONDS=8
BOT_FAST_REPLY_COOLDOWN=5

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lumio
POSTGRES_PASSWORD=lumio_pass
POSTGRES_DATABASE=lumio

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=20

# ── Elasticsearch ──
ES_HOSTS=http://localhost:9200
# 安全认证已关闭（开发环境），以下字段仅生产环境使用
# ES_USERNAME=elastic
# ES_PASSWORD=elastic_pass

# ── Milvus ──
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ── MinIO ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# ── LLM (Ollama) ──
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_PRIMARY_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=qwen2.5:0.5b

# ── gRPC 服务 ──
CLS_GRPC_HOST=localhost
CLS_GRPC_PORT=50051
RAG_GRPC_HOST=localhost
RAG_GRPC_PORT=50052
SAFETY_GRPC_HOST=localhost
SAFETY_GRPC_PORT=50053

# ── 坐席辅助 ──
ASSIST_SCRIPT_TIMEOUT_MS=500
ASSIST_KNOWLEDGE_TIMEOUT_MS=600
ASSIST_ALERT_TIMEOUT_MS=300
ASSIST_PRODUCT_TIMEOUT_MS=400
ASSIST_THROTTLE_WINDOW_MS=800

# ── MCP 工具层 ──
# 总开关：默认关闭，行为与现状完全一致（零回归）。开启后 bot 才会经 MCP 调用受治理工具。
MCP_ENABLED=false
# MCP 入口地址。生产/网关联调指向 Higress AI 网关的统一 MCP 入口（streamable-http）；
# 本地也可指向 Python 参考 Server（见文末）。
MCP_ENDPOINT=http://127.0.0.1:10000/mcp/credit-card
MCP_TIMEOUT_SECONDS=10.0
# 敏感工具白名单（JSON 数组），与工具注解 destructiveHint 取并集；命中者需客户确认后执行。
# 默认列出 mcp-server 中的 4 个写类工具，确保开启 MCP 后确认状态机即刻生效。
MCP_SENSITIVE_TOOLS=["apply_bill_installment","adjust_temp_credit_limit","repay_credit_card","report_card_lost"]
# 工具调用循环最大轮数（防死循环）
MCP_MAX_TOOL_ITERATIONS=5
# 待确认操作（pending_action）过期时间（秒）
MCP_CONFIRMATION_TTL_SECONDS=300
#
# ── 工具护栏（Python 侧纵深防御，与 Higress 治理互补）──
# 默认全空 → 不做授权/额度限制（零回归）。配置后转为「显式允许」的保守策略。
# 按角色的工具授权白名单（JSON）：未列出的角色/工具将被拒绝并审计。
# 形如：MCP_TOOL_ROLE_ALLOWLIST={"customer":["query_card_bill","query_points","apply_bill_installment"]}
MCP_TOOL_ROLE_ALLOWLIST={}
# 敏感工具入参额度上限（JSON）：超过即拒绝并审计。
# 形如：MCP_TOOL_AMOUNT_LIMITS={"apply_bill_installment":50000,"adjust_temp_credit_limit":20000}
MCP_TOOL_AMOUNT_LIMITS={}
# 视为「金额」的入参键名（命中任一且超上限即拒绝）
MCP_AMOUNT_ARG_KEYS=["amount","target_limit","target_amount","limit"]
#
# ── 渐进式工具暴露（Progressive Disclosure）──
# 默认关闭 → bot 业务路由与工具暴露完全同现状（零回归）。
# 开启后：命中「查询类工具意图」（账单/交易/额度/分期/积分）且置信度达标时，
# 仅向 LLM 暴露该意图对应的工具子集，降低 22+ 工具场景下的选择噪声与 token 开销；
# 未命中/低置信度时回落全量或知识问答（RAG）。
MCP_PROGRESSIVE_DISCLOSURE_ENABLED=false
# 渐进式暴露置信度阈值：意图置信度 >= 此值才裁剪到子集，否则暴露全量交 LLM 判断。
MCP_PD_CONFIDENCE_THRESHOLD=0.7
# 意图→工具子集映射（JSON）。留空则用内置默认（五类查询意图各自常用工具子集）。
# 单后端时用工具原名；多后端路由模式下用带域前缀全名（见下方 MCP_BACKENDS）。
# 形如：MCP_INTENT_TOOL_MAP={"bill_query":["query_card_bill","query_bill_detail"]}
#
# ── 路由模式：多 MCP 后端（host 侧合并 + 分发）──
# 默认留空 → 单后端（用 MCP_ENDPOINT、空前缀、名字契约不变，零回归）。
# 非空（JSON 数组）时，host 连接每个后端、按 prefix 生成域命名空间工具名并合并目录，
# 按 name→(server, raw_name) 分发调用；某后端失败仅其工具缺席，不整体报错（优雅降级）。
# 形如：
# MCP_BACKENDS=[{"name":"card","endpoint":"http://127.0.0.1:10000/mcp/credit-card","prefix":"card.","sensitive_tools":["repay_credit_card"]},{"name":"points","endpoint":"http://127.0.0.1:10000/mcp/points","prefix":"pts."}]
#
# 本地联调 MCP Server（两选一，均返回 mock 数据，不接真实银行系统）：
#   A) Python 参考 Server（streamable-http，端口 8080，与 Python 客户端传输一致）：
#      poetry run python -m smartcs.services.tools.reference_server
#      → MCP_ENABLED=true 且 MCP_ENDPOINT=http://127.0.0.1:8080/mcp
#   B) Java MCP Server（mcp-server/，Spring AI，10 个信用卡工具，SSE 端口 8090）：
#      make mcp-server-run   # 或 cd mcp-server && mvn spring-boot:run
#      生产环境经 Higress AI 网关桥接传输后由 Python 客户端调用；
#      本地直连 SSE 需将 MCP_ENDPOINT 指向 http://127.0.0.1:8090/sse。

# ── Higress AI 网关 + Nacos MCP Registry（opt-in，默认不启动）──
# 启动方式：make gateway-up（docker compose --profile gateway），零回归——默认 make up 不含网关。
# Nacos 服务发现 + MCP Registry 地址（Java MCP Server 以 profile=nacos 启动时注册到此）。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
# 是否启用 Nacos 鉴权（生产建议开启并配置 NACOS_AUTH_TOKEN / 用户名密码）。
NACOS_AUTH_ENABLE=false
# Higress 统一 MCP 数据面入口端口（容器 80 → 宿主 10000），与上面 MCP_ENDPOINT 对应。
HIGRESS_MCP_PORT=10000
# Higress 控制台端口（容器 8080 → 宿主 18080）。
HIGRESS_CONSOLE_PORT=18080

# ── Docker Compose 中间件密码 ──
# 这些值被 docker-compose.yml 引用
POSTGRES_PASSWORD_DOCKER=lumio_pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# ── 全链路可观测性（Tracing）──
# Python span 生成/导出总开关：默认 true（沿用现状）。设为 false 则 @traced 与自动探针零开销空操作。
LUMIO_TRACING_ENABLED=true
# OTLP 追踪后端主机名。本地缺省 localhost；docker compose 内由 compose 注入 jaeger。
# 未部署 Jaeger 时导出静默失败，不影响主链路。
JAEGER_HOST=localhost
# Java MCP Server 追踪采样率（0~1；prod 建议低采样如 0.1）与 OTLP 端点。
MCP_TRACING_SAMPLE=0.1
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
